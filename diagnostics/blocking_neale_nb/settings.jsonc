// MDTF POD settings for blocking_neale_nb (Rich Neale's blocking diagnostic, notebook version)
//
// JSON with "//" comments (JSONC). The same text is held in the notebook's
// POD settings cell; the notebook's export cell writes it back out as this file.
{
  "settings" : {
    // Notebook run by the framework (jupyter nbconvert --execute)
    "driver" : "blocking_main_esnb.ipynb",
    "long_name" : "Rich Neale's blocking diagnostic",
    "convention": "cesm",
    "description" : "Rich Neale's blocking diagnostic (notebook version)",

    // POD options. The framework passes these to the notebook as environment
    // variables, so every value is a string; lists are comma-separated.
    "pod_env_vars" : {
      // Season for the blocking frequency: DJF, MAM, JJA, SON or ANN
      "MDTF_BLOCKING_SEASON"      : "DJF",
      // Hemisphere(s): nhem, shem
      "MDTF_BLOCKING_HEMISPHERE"  : "nhem",
      // Obs and model ensembles to compare with the MDTF case(s)
      "MDTF_BLOCKING_ENSEMBLES"   : "ERA5,MERRA,CESM2",
      // Members to use from each ensemble above (same order)
      "MDTF_BLOCKING_ENS_MEMBERS" : "1,1,2",
      // Years for the obs and model ensembles. Blank: use the MDTF case years.
      // (The NCL version of this POD compared against 1979-1999.)
      "MDTF_BLOCKING_REF_FIRSTYR" : "",
      "MDTF_BLOCKING_REF_LASTYR"  : ""
    },

    // The framework picks the conda env from the first language with a
    // non-empty package list, so the list must not be empty.
    "runtime_requirements": {
      "python3": ["numpy", "pandas", "xarray", "scipy", "matplotlib", "cartopy", "intake-esm", "nbconvert"]
    }
  },

  "dimensions": {
    "lat": {
      "standard_name": "latitude",
      "units": "degrees_north",
      "axis": "Y"
    },
    "lon": {
      "standard_name": "longitude",
      "units": "degrees_east",
      "axis": "X"
    },
    "lev": {
      "standard_name": "air_pressure",
      "units": "hPa",
      "positive": "down",
      "axis": "Z"
    },
    "time": {"standard_name": "time"}
  },

  "varlist" : {
    "zg": {
      "path_variable" : "MODEL_DATA_PATH",
      "standard_name" : "geopotential_height",
      "units": "m",
      "realm" : "atmos",
      "frequency" : "day",
      "dimensions": ["time", "lat", "lon"],
      "scalar_coordinates": {"lev" : 500}
    }
  }
}
