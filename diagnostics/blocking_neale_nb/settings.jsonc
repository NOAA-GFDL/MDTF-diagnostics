// MDTF POD settings for blocking_neale_nb (Rich Neale's blocking diagnostic, notebook version)
//
// JSON with "//" comments (JSONC). The same text is held in the notebook's
// POD settings cell; the notebook's export cell writes it back out as this file.
{
  "settings" : {
    // Notebook run by the framework (jupyter nbconvert --execute)
    "driver" : "blocking_main.ipynb",
    "long_name" : "Rich Neale's blocking diagnostic",
    "convention": "cesm",
    "description" : "Rich Neale's blocking diagnostic (notebook version)",

    // POD options. The framework passes these to the notebook as environment
    // variables, so every value is a string; lists are comma-separated.
    "pod_env_vars" : {
      // Season for the blocking frequency: DJF, MAM, JJA, SON or ANN
      "MDTF_BLOCKING_SEASON"      : "DJF",
      // Hemisphere: only nhem is implemented
      "MDTF_BLOCKING_HEMISPHERE"  : "nhem",
      // Obs and model ensembles to compare with the MDTF case(s): ERA5, MERRA (obs);
      // timeslice3 (MDTF v3 timeslice CESM run, 1995-2014) and CESM2 (large ensemble)
      // (model ensembles). Their blocking frequencies are shipped as digested data in
      // the POD's obs data ($OBS_DATA) for the members and years below, so their raw
      // data are not read. Other choices need raw daily Z500 through
      // MDTF_BLOCKING_RAW_CATALOG; also known, but untested with this version: ERAI,
      // CESM1, E3SMv1, E3SMv2, EAMv2, CAM6 (see RAW_DATA in blocking_utils.py).
      "MDTF_BLOCKING_ENSEMBLES"   : "ERA5,MERRA,timeslice3,CESM2",
      // Members to use from each ensemble above (same order)
      "MDTF_BLOCKING_ENS_MEMBERS" : "1,1,1,5",
      // Years for the obs and model ensembles: one year for all, or one per entry in
      // MDTF_BLOCKING_ENSEMBLES (same order). Blank: use the MDTF case years.
      // (The NCL version of this POD compared against 1979-1999.)
      "MDTF_BLOCKING_REF_FIRSTYR" : "1979,1979,1995,1979",
      "MDTF_BLOCKING_REF_LASTYR"  : "1999,1999,2014,1999",
      // Blocking frequencies are saved as netCDF and reused when a later run needs the
      // same index, dataset, members, years and season. Results from an older version
      // of the calculation are recomputed automatically.
      // Recompute anyway: "False", "True" (everything) or dataset names, e.g. "CESM2,ERA5"
      "MDTF_BLOCKING_RECOMPUTE"   : "False",
      // Where to keep them. Blank: this run's output (model/netCDF). Set a shared
      // directory to reuse results across runs and cases. The shipped results in
      // $OBS_DATA are read after this directory and are never written to.
      "MDTF_BLOCKING_CACHE_DIR"   : "",
      // ESM-intake catalog of the raw daily Z500 of the comparison datasets, used only
      // for results not in the cache or $OBS_DATA (made by blocking_utils.make_raw_catalog;
      // NCAR GLADE only). Blank: none, so only the shipped choices work.
      "MDTF_BLOCKING_RAW_CATALOG" : ""
    },

    // The framework picks the conda env from the first language with a
    // non-empty package list, so the list must not be empty.
    "runtime_requirements": {
      "python3": ["numpy", "pandas", "xarray", "scipy", "matplotlib", "cartopy", "intake-esm", "nbconvert"]
    }
  },

  "dimensions": {
    "lat": {
      "standard_name": "latitude",
      "units": "degrees_north",
      "axis": "Y"
    },
    "lon": {
      "standard_name": "longitude",
      "units": "degrees_east",
      "axis": "X"
    },
    "lev": {
      "standard_name": "air_pressure",
      "units": "hPa",
      "positive": "down",
      "axis": "Z"
    },
    "time": {"standard_name": "time"}
  },

  "varlist" : {
    "zg": {
      "path_variable" : "MODEL_DATA_PATH",
      "standard_name" : "geopotential_height",
      "units": "m",
      "realm" : "atmos",
      "frequency" : "day",
      "dimensions": ["time", "lat", "lon"],
      "scalar_coordinates": {"lev" : 500}
    }
  }
}
