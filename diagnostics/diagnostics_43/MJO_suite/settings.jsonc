// MJO diagnostics suite (from AMWG variability diagnostic package)
//
// All text to the right of an unquoted "//" is a comment and ignored, as well
// as blank lines (JSONC quasi-standard.) JSON doesn't support line continuation
// in strings, so you'll want to turn word wrap on in your editor.
//
{
  "settings" : {
    "driver" : "MJO_suite.py",
    "long_name" : "MJO diagnostics suite (from AMWG variability diagnostic package)",
    "convention" : "cesm",
    "description" : "MJO CLIVAR suite (NCAR)",
    "runtime_requirements": {
      "python3": [],
      "ncl": ["contributed", "gsn_code", "gsn_csm", "shea_util", "diagnostics_cam"]
    } 
  }, //setttings
  "data": {
    "frequency": "day"
  }, //data
  "dimensions": {
    "lat": {
      "standard_name": "latitude",
      "units": "degrees_north",
      "axis": "Y"
    },
    "lon": {
      "standard_name": "longitude",
      "units": "degrees_east",
      "axis": "X"
    },
    "time": {"standard_name": "time"},
    "lev": {
      "native_name": "plev19",
      "standard_name": "air_pressure",
      "units": "Pa",
      "axis": "Z",
      "positive": "down"
    }
  }, //dimensions
  "varlist": {
    "rlut": {
      "standard_name": "toa_outgoing_longwave_flux",
      "realm": "atmos",
      "units": "W m-2",
      "dimensions": ["time", "lat", "lon"]
    },
    "pr": {
      "standard_name": "precipitation_rate",
      "realm": "atmos",
      "units": "m s-1",
      "dimensions": ["time", "lat", "lon"]
    },
    "u200": {
      "standard_name": "eastward_wind",
      "native_name": "ua",
      "realm": "atmos_cmip",
      "units": "m s-1",
      "dimensions": ["time", "lev","lat", "lon"]//,
      //"scalar_coordinates": {
      //"lev": 20000
       //}
    },
    "u850": {
      "standard_name": "eastward_wind",
      "native_name": "ua",
      "realm": "atmos_cmip",
      "units": "m s-1",
      "dimensions": ["time", "lev","lat", "lon"]//,
     // "scalar_coordinates": {
     // "lev": 85000
      //}
    },
    "v200": {
      "standard_name": "northward_wind",
      "native_name": "va",
      "realm": "atmos_cmip",
      "units": "m s-1",
      "dimensions": ["time","lev","lat", "lon"]//,
    //  "scalar_coordinates": {"lev": 20000}
    },
    "v850": {
      "native_name":"va",
      "standard_name": "northward_wind",
      "realm": "atmos_cmip",
      "units": "m s-1",
      "dimensions": ["time", "lev","lat", "lon"]//,
     // "scalar_coordinates": {"lev": 85000}
   }
  } //dimensions
}
